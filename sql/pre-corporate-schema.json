{
  "view": " SELECT p.id AS pick_id,\n p.month,\n p.stock_name,\n p.stock_code,\n p.market,\n p.reason,\n p.target_price,\n p.current_cap,\n p.target_cap,\n p.submitted_at,\n p.price_at,\n p.carried_from,\n m.id AS member_id,\n m.name AS member_name,\n b.price AS buy_price,\n b.quantity AS buy_quantity,\n b.traded_at AS bought_at,\n sv.price AS sell_price,\n sv.traded_at AS sold_at,\n CASE\n WHEN sv.price IS NOT NULL THEN 'sold'::text\n ELSE 'hold'::text\n END AS status,\n CASE\n WHEN b.price IS NOT NULL AND sv.price IS NOT NULL THEN round((sv.price - b.price)::numeric / b.price::numeric * 100::numeric, 2)\n ELSE NULL::numeric\n END AS realized_return\n FROM picks p\n JOIN members m ON p.member_id = m.id\n LEFT JOIN trades b ON b.pick_id = p.id AND b.trade_type = 'buy'::text\n LEFT JOIN trades sv ON sv.pick_id = p.id AND sv.trade_type = 'sell'::text;",
