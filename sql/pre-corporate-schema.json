  "triggers": [
    {
      "tgname": "trg_calc_settlement",
      "proname": "calc_settlement",
      "definition": "CREATE TRIGGER trg_calc_settlement BEFORE INSERT ON public.settlements FOR EACH ROW EXECUTE FUNCTION calc_settlement()",
      "table_name": "settlements",
      "function_definition": "CREATE OR REPLACE FUNCTION public.calc_settlement()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nDECLARE\r\n v_base integer;\r\nBEGIN\r\n -- 현재 기준금액 조회\r\n SELECT base_amount INTO v_base FROM members WHERE id = NEW.member_id;\r\n\r\n -- net_profit\r\n NEW.net_profit := NEW.gross_profit - NEW.tax_fee;\r\n\r\n -- return_rate (기준금액 대비)\r\n IF v_base IS NOT NULL AND v_base > 0 THEN\r\n NEW.return_rate := ROUND(NEW.net_profit::numeric / v_base * 100, 2);\r\n ELSE\r\n NEW.return_rate := 0;\r\n END IF;\r\n\r\n -- new_base_amount (손실 복구 없이 순수 누적)\r\n NEW.new_base_amount := COALESCE(v_base, 1000000) + NEW.net_profit;\r\n\r\n RETURN NEW;\r\nEND;\r\n$function$\n"
    },
    {
      "tgname": "trg_update_member_base",
      "proname": "update_member_base",
      "definition": "CREATE TRIGGER trg_update_member_base AFTER INSERT ON public.settlements FOR EACH ROW EXECUTE FUNCTION update_member_base()",
      "table_name": "settlements",
      "function_definition": "CREATE OR REPLACE FUNCTION public.update_member_base()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n -- new_base_amount 가 NULL 이면 갱신 건너뜀\r\n IF NEW.new_base_amount IS NOT NULL THEN\r\n UPDATE members SET base_amount = NEW.new_base_amount WHERE id = NEW.member_id;\r\n END IF;\r\n RETURN NEW;\r\nEND;\r\n$function$\n"
    },
    {
      "tgname": "trg_auto_settle",
      "proname": "auto_settle_on_sell",
      "definition": "CREATE TRIGGER trg_auto_settle AFTER INSERT ON public.trades FOR EACH ROW EXECUTE FUNCTION auto_settle_on_sell()",
      "table_name": "trades",
      "function_definition": "CREATE OR REPLACE FUNCTION public.auto_settle_on_sell()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nDECLARE\r\n v_buy_price integer;\r\n v_buy_qty integer;\r\n v_gross integer;\r\n v_fee integer;\r\n v_pick_member uuid;\r\nBEGIN\r\n -- sell 거래가 아니면 무시\r\n IF NEW.trade_type <> 'sell' THEN\r\n RETURN NEW;\r\n END IF;\r\n\r\n -- 같은 pick의 매수 거래 조회\r\n SELECT price, quantity, member_id\r\n INTO v_buy_price, v_buy_qty, v_pick_member\r\n FROM trades\r\n WHERE pick_id = NEW.pick_id\r\n AND trade_type = 'buy'\r\n ORDER BY traded_at ASC\r\n LIMIT 1;\r\n\r\n IF v_buy_price IS NULL THEN\r\n -- 매수 내역 없으면 결산 생략\r\n RETURN NEW;\r\n END IF;\r\n\r\n -- 수량: 매도 수량 사용 (매수 수량과 다를 수 있음)\r\n -- gross_profit: (매도가 - 매수가) × 수량\r\n v_gross := (NEW.price - v_buy_price) * NEW.quantity;\r\n\r\n -- 수수료: 매수금액 + 매도금액의 0.3% (증권거래세 포함 근사치)\r\n v_fee := -ROUND((v_buy_price * NEW.quantity + NEW.price * NEW.quantity) * 0.003);\r\n\r\n -- 이미 결산이 존재하면 중복 생성 방지\r\n IF EXISTS (\r\n SELECT 1 FROM settlements\r\n WHERE pick_id = NEW.pick_id AND member_id = NEW.member_id\r\n ) THEN\r\n -- 기존 결산 업데이트\r\n UPDATE settlements SET\r\n sell_price = NEW.price,\r\n quantity = NEW.quantity,\r\n gross_profit= v_gross,\r\n tax_fee = v_fee,\r\n settled_at = NOW()\r\n WHERE pick_id = NEW.pick_id AND member_id = NEW.member_id;\r\n ELSE\r\n -- 새 결산 생성 (calc_settlement 트리거가 net_profit 등 자동 계산)\r\n INSERT INTO settlements (\r\n member_id, pick_id,\r\n buy_price, sell_price, quantity,\r\n gross_profit, tax_fee\r\n ) VALUES (\r\n NEW.member_id, NEW.pick_id,\r\n v_buy_price, NEW.price, NEW.quantity,\r\n v_gross, v_fee\r\n );\r\n END IF;\r\n\r\n RETURN NEW;\r\nEND;\r\n$function$\n"
    }
  ],
